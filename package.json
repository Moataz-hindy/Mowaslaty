    "android:toolchain": "node scripts/check-android-toolchain.mjs",
    "android:test": "node --test scripts/native-release.test.mjs",
    "community:test": "node scripts/community-route-ids.mjs --check && node --test scripts/community-api.test.mjs scripts/community-sqlite.test.mjs scripts/community-integration.test.mjs scripts/community-content-filter.test.mjs",
