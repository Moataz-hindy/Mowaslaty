# Copy this file to `.env.local` and fill in your keys.
# Keys starting with VITE_ are bundled into the website (visible to visitors).
# Map-tile keys are designed to be public like this.

# CARTO basemaps key - free, from https://carto.com/basemaps/apikey/
VITE_CARTO_KEY=

# NOTE: the walking-route key is NOT set here. It is a server secret:
# add it in Cloudflare Pages -> Settings -> Variables and Secrets as GEOAPIFY_KEY
# (or ORS_API_KEY for openrouteservice), and in `.dev.vars` for local testing with wrangler.
